# .env.example
# ==============================================================================
# Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Nebius AI Cloud
NEBIUS_API_KEY="your-nebius-api-key-here"
NEBIUS_API_URL="https://api.nebius.com/v1"

# Enterprise Asset Management (SAP / Maximo)
SAP_AUTH_TOKEN="your-sap-oauth-token-here"
SAP_API_URL="https://sap-gateway.example.com/api"

# PostgreSQL Database
POSTGRES_USER="pipeline_admin"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="pipeline_ai"
DATABASE_URL="postgresql://user:password@localhost:5432/pipeline_ai"

# Grafana Monitoring
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="change-me-in-production"

# mTLS Certificate Paths
MQTT_CA_CERT="./security/certs/ca.crt"
MQTT_CLIENT_CERT="./security/certs/client.crt"
MQTT_CLIENT_KEY="./security/certs/client.key"