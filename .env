# .env
# ==============================================================================
# Environment Variables (SENSITIVE - DO NOT COMMIT)
# ==============================================================================

# Nebius AI Cloud
NEBIUS_API_KEY="your-actual-nebius-api-key-here"
NEBIUS_API_URL="https://api.nebius.com/v1"

# Enterprise Asset Management (SAP / Maximo)
SAP_AUTH_TOKEN="your-actual-sap-oauth-token-here"
SAP_API_URL="https://sap-gateway.exxonmobil.com/sap/opu/odata/sap/PM_WORKORDER"

# PostgreSQL Database
POSTGRES_USER="pipeline_admin"
POSTGRES_PASSWORD="your-secure-db-password-here"
POSTGRES_DB="pipeline_ai"
DATABASE_URL="postgresql://pipeline_admin:your-secure-db-password-here@localhost:5432/pipeline_ai"

# Grafana Monitoring
GRAFANA_ADMIN_USER="admin"
GRAFANA_ADMIN_PASSWORD="your-secure-grafana-password-here"

# mTLS Certificate Paths (Optional if using default paths)
MQTT_CA_CERT="./security/certs/ca.crt"
MQTT_CLIENT_CERT="./security/certs/client.crt"
MQTT_CLIENT_KEY="./security/certs/client.key"